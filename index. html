            },
            {
                id: 12,
                dayAge: 112,
                ageText: "Umur 112 Hari (16 Minggu / Pre-Lay)",
                vaccine: "ND + IB + IBD + EDS Inaktif & ND Live",
                disease: "Kompleks ND, IB, IBD, EDS Pre-layer",
