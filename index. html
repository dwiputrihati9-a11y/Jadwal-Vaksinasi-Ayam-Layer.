        // State Management
        let userState = {
            docDate: '',
            completedItems: {},
            notes: {},
            filterStatus: 'all'
        };

        let currentActiveNoteId = null;

        // Initialization
        window.addEventListener('DOMContentLoaded', () => {
            // Set default DOC Date to today minus 7 days for quick test
            const today = new Date();
            const defaultDOC = new Date(today);
            defaultDOC.setDate(today.getDate() - 7);
            
            const docInput = document.getElementById('docDate');
            docInput.value = defaultDOC.toISOString().split('T')[0];

            loadLocalStorage();
            recalculateDates();
            lucide.createIcons();
        });

        // Local Storage Handling
        function loadLocalStorage() {
            const saved = localStorage.getItem('vaksi_layer_data');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    userState.completedItems = parsed.completedItems || {};
                    userState.notes = parsed.notes || {};
                    if(parsed.docDate) {
                        document.getElementById('docDate').value = parsed.docDate;
                    }
                    if(parsed.flockName) {
                        document.getElementById('flockName').value = parsed.flockName;
                    }
                    if(parsed.birdCount) {
                        document.getElementById('birdCount').value = parsed.birdCount;
                    }
                } catch(e) {
                    console.error('Failed loading saved state', e);
                }
            }
        }

        function saveLocalStorage() {
            userState.docDate = document.getElementById('docDate').value;
            const dataToSave = {
                docDate: userState.docDate,
                flockName: document.getElementById('flockName').value,
                birdCount: document.getElementById('birdCount').value,
                completedItems: userState.completedItems,
                notes: userState.notes
            };
            localStorage.setItem('vaksi_layer_data', JSON.stringify(dataToSave));
        }

        // Recalculate Dates & Refresh UI
        function recalculateDates() {
            saveLocalStorage();
            renderSchedule();
            updateStatistics();
            updatePrintInfo();
        }

        // Format Date Indonesian
        function formatDateIndo(dateObj) {
            const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agust', 'Sep', 'Okt', 'Nov', 'Des'];
            
            const dayName = days[dateObj.getDay()];
            const dayNum = dateObj.getDate();
            const monthName = months[dateObj.getMonth()];
            const year = dateObj.getFullYear();

            return `${dayName}, ${dayNum} ${monthName} ${year}`;
        }

        // Filter Handlers
        function setFilterStatus(status) {
            userState.filterStatus = status;
            
            // Toggle active styles
            ['btnStatusAll', 'btnStatusPending', 'btnStatusDone'].forEach(id => {
                const btn = document.getElementById(id);
                btn.classList.remove('bg-white', 'shadow-sm', 'text-slate-800', 'font-semibold');
                btn.classList.add('text-slate-600');
            });

            if (status === 'all') {
                document.getElementById('btnStatusAll').classList.add('bg-white', 'shadow-sm', 'text-slate-800', 'font-semibold');
            } else if (status === 'pending') {
                document.getElementById('btnStatusPending').classList.add('bg-white', 'shadow-sm', 'text-slate-800', 'font-semibold');
            } else if (status === 'done') {
                document.getElementById('btnStatusDone').classList.add('bg-white', 'shadow-sm', 'text-slate-800', 'font-semibold');
            }

            renderSchedule();
        }

        // Render Schedule Table
        function renderSchedule() {
            const docValue = document.getElementById('docDate').value;
            const methodFilter = document.getElementById('methodFilter').value;
            const searchQuery = document.getElementById('searchInput').value.toLowerCase();
            const tbody = document.getElementById('scheduleTableBody');

            if (!docValue) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400">Silakan masukkan tanggal DOC terlebih dahulu.</td></tr>`;
                return;
            }

            const docDate = new Date(docValue);
            tbody.innerHTML = '';

            masterSchedule.forEach(item => {
                // Calculate target date
                const targetDate = new Date(docDate);
                targetDate.setDate(docDate.getDate() + (item.dayAge - 1));

                const isDone = !!userState.completedItems[item.id];

                // Applying Status Filter
                if (userState.filterStatus === 'pending' && isDone) return;
                if (userState.filterStatus === 'done' && !isDone) return;

                // Applying Method Filter
                if (methodFilter !== 'all' && !item.method.includes(methodFilter)) return;

                // Applying Search Query
                if (searchQuery) {
                    const matchName = item.vaccine.toLowerCase().includes(searchQuery);
                    const matchDisease = item.disease.toLowerCase().includes(searchQuery);
                    if (!matchName && !matchDisease) return;
                }

                // Badge colors for Method
                let badgeClass = "bg-slate-100 text-slate-700";
                if(item.methodBadge === 'Injeksi') badgeClass = "bg-rose-100 text-rose-800 border-rose-200";
                if(item.methodBadge === 'Tetes') badgeClass = "bg-blue-100 text-blue-800 border-blue-200";
                if(item.methodBadge === 'Air Minum') badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                if(item.methodBadge === 'Tusuk Sayap') badgeClass = "bg-amber-100 text-amber-800 border-amber-200";

                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-50/80 transition ${isDone ? 'bg-emerald-50/40' : ''}`;

                const hasNote = !!userState.notes[item.id];

                tr.innerHTML = `
                    <td class="py-4 px-4 text-center no-print">
                        <input type="checkbox" onchange="toggleDone(${item.id})" ${isDone ? 'checked' : ''} 
                            class="w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500 cursor-pointer">
                    </td>
                    <td class="py-4 px-4 font-semibold text-slate-900">
                        ${item.ageText}
                        <div class="text-xs font-normal text-slate-500">Hari ke-${item.dayAge}</div>
                    </td>
                    <td class="py-4 px-4 font-medium text-emerald-800">
                        ${formatDateIndo(targetDate)}
                    </td>
                    <td class="py-4 px-4">
                        <div class="font-bold text-slate-800 ${isDone ? 'line-through text-slate-400' : ''}">${item.vaccine}</div>
                        <div class="text-xs text-slate-500">${item.disease}</div>
                    </td>
                    <td class="py-4 px-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeClass} mb-1">
                            ${item.method}
                        </span>
                        <div class="text-xs text-slate-600 font-mono">${item.dosis}</div>
                    </td>
                    <td class="py-4 px-4 text-xs text-slate-600">
                        ${item.type}
                    </td>
                    <td class="py-4 px-4 text-center no-print">
                        <button onclick="openNoteModal(${item.id})" class="inline-flex items-center px-2.5 py-1.5 border border-slate-200 text-xs rounded-lg ${hasNote ? 'bg-amber-50 text-amber-700 border-amber-300 font-semibold' : 'text-slate-600 hover:bg-slate-100'} transition">
                            <i data-lucide="notebook-pen" class="w-3.5 h-3.5 mr-1"></i>
                            ${hasNote ? 'Ada Catatan' : 'Catatan'}
                        </button>
                    </td>
                `;

                tbody.appendChild(tr);
            });

            if (tbody.children.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400">Tidak ada jadwal yang cocok dengan filter pencarian.</td></tr>`;
            }

            lucide.createIcons();
        }

        // Toggle Done Checkbox
        function toggleDone(id) {
            userState.completedItems[id] = !userState.completedItems[id];
            saveLocalStorage();
            renderSchedule();
            updateStatistics();
        }

        // Update Header & Dashboard Statistics
        function updateStatistics() {
            const total = masterSchedule.length;
            const completedCount = Object.values(userState.completedItems).filter(Boolean).length;
            const pendingCount = total - completedCount;
            const pct = Math.round((completedCount / total) * 100);

            document.getElementById('statTotalVax').innerText = total;
            document.getElementById('statCompletedVax').innerText = completedCount;
            document.getElementById('statCompletedPct').innerText = `${pct}% Terlaksana`;
            document.getElementById('statPendingVax').innerText = pendingCount;

            document.getElementById('progressBarText').innerText = `${pct}%`;
            document.getElementById('progressBarFill').style.width = `${pct}%`;

            // Age Calculation
            const docVal = document.getElementById('docDate').value;
            if(docVal) {
                const docDate = new Date(docVal);
                const today = new Date();
                // Set hours to 0 to measure exact days difference
                docDate.setHours(0,0,0,0);
                today.setHours(0,0,0,0);
                
                const diffTime = today - docDate;
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1; // Day 1 is DOC day

                if (diffDays >= 1) {
                    const weeks = Math.floor(diffDays / 7);
                    const remDays = diffDays % 7;
                    document.getElementById('statCurrentAge').innerText = `${diffDays} Hari`;
                    document.getElementById('statCurrentWeeks').innerText = `(${weeks} Mgg ${remDays} Hari)`;
                } else {
                    document.getElementById('statCurrentAge').innerText = `Belum DOC`;
                    document.getElementById('statCurrentWeeks').innerText = `(Tgl Mundur)`;
                }
            }
        }

        // Reset Progress
        function resetProgress() {
            if(confirm("Apakah Anda yakin ingin mereset semua status vaksinasi yang selesai?")) {
                userState.completedItems = {};
                userState.notes = {};
                saveLocalStorage();
                renderSchedule();
                updateStatistics();
            }
        }

        // Modal Note Handling
        function openNoteModal(id) {
            currentActiveNoteId = id;
            const item = masterSchedule.find(x => x.id === id);
            document.getElementById('modalTitle').innerText = `Catatan: ${item.vaccine}`;
            document.getElementById('modalNoteText').value = userState.notes[id] || '';
            document.getElementById('noteModal').classList.remove('hidden');
            document.getElementById('noteModal').classList.add('flex');
        }

        function closeNoteModal() {
            document.getElementById('noteModal').classList.add('hidden');
            document.getElementById('noteModal').classList.remove('flex');
            currentActiveNoteId = null;
        }

        function saveNote() {
            if (currentActiveNoteId) {
                const text = document.getElementById('modalNoteText').value.trim();
                if (text) {
                    userState.notes[currentActiveNoteId] = text;
                } else {
                    delete userState.notes[currentActiveNoteId];
                }
                saveLocalStorage();
                renderSchedule();
                closeNoteModal();
            }
        }

        // Update Print Information Header
        function updatePrintInfo() {
            const flock = document.getElementById('flockName').value || 'Flock Ayam Petelur';
            const doc = document.getElementById('docDate').value || '-';
            const birds = document.getElementById('birdCount').value || '0';

            document.getElementById('printTitle').innerText = `Jadwal Vaksinasi Ayam Petelur - ${flock}`;
            document.getElementById('printSubTitle').innerText = `Tanggal DOC / Chick-In: ${doc} | Populer: ${birds} Ekor`;
        }

        // Export Data to CSV
        function exportToCSV() {
            const docVal = document.getElementById('docDate').value;
            if (!docVal) {
                alert('Silakan tentukan tanggal DOC terlebih dahulu.');
                return;
            }

            const docDate = new Date(docVal);
            const flock = document.getElementById('flockName').value || 'Kandang';
            
            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Umur,Estimasi Tanggal,Nama Vaksin,Target Penyakit,Metode,Dosis,Tipe,Status,Catatan\n";

            masterSchedule.forEach(item => {
                const targetDate = new Date(docDate);
                targetDate.setDate(docDate.getDate() + (item.dayAge - 1));
                const dateStr = targetDate.toISOString().split('T')[0];
                const isDone = userState.completedItems[item.id] ? "Selesai" : "Belum";
                const note = (userState.notes[item.id] || '').replace(/"/g, '""');

                csvContent += `"${item.ageText}","${dateStr}","${item.vaccine}","${item.disease}","${item.method}","${item.dosis}","${item.type}","${isDone}","${note}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Jadwal_Vaksin_${flock.replace(/\s+/g, '_')}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
